{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach: Electron main",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/electron/dist/**/*.cjs"]
    },
    {
      "name": "Attach: Renderer",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/angular",
      "urlFilter": "http://localhost:4200/*"
    },
    {
      "name": "Python: backend",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/run.py",
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "env": { "DREAMER_PORT": "8765", "DREAMER_VERSION": "dev" },
      "console": "integratedTerminal"
    },
    {
      "name": "Vitest: current file",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${relativeFile}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Debug app (attach)",
      "configurations": ["Attach: Electron main", "Attach: Renderer"],
      "stopAll": true
    }
  ]
}
