{
  "name": "dreamer-studio",
  "private": true,
  "version": "0.0.0",
  "author": "datntdev",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "lint": "node scripts/check-i18n.mjs && eslint . && node scripts/py.mjs lint",
    "format": "prettier --write . && node scripts/py.mjs format",
    "format:check": "prettier --check . && node scripts/py.mjs format:check",
    "test": "vitest run && pnpm --filter @dreamer/angular test && node scripts/py.mjs test",
    "test:coverage": "vitest run --coverage && pnpm --filter @dreamer/angular test:coverage && node scripts/py.mjs test:coverage",
    "check": "pnpm lint && pnpm format:check && pnpm test",
    "py:setup": "node scripts/py.mjs setup",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs build",
    "start": "pnpm --filter @dreamer/electron start",
    "package": "node scripts/build.mjs package",
    "storybook": "pnpm --filter @dreamer/angular storybook",
    "storybook:build": "pnpm --filter @dreamer/angular storybook:build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/istanbul-lib-coverage": "1.0.2",
    "@vitest/istanbul-lib-report": "1.0.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
